-- ============================================================================
-- Question 1: INNER JOIN – Employees and Offices
-- Task: Retrieve firstName, lastName, email, and officeCode for all employees
--       by joining the employees table with the offices table using officeCode.
-- ============================================================================

SELECT
e.firstName,
e.lastName,
e.email,
e.officeCode
FROM
employees AS e
INNER JOIN
offices AS o ON e.officeCode = o.officeCode;

-- ============================================================================
-- Question 2: LEFT JOIN – Products and Product Lines
-- Task: Retrieve productName, productVendor, and productLine by combining
--       the products table with the productlines table using productLine.
-- ============================================================================

SELECT
p.productName,
p.productVendor,
p.productLine
FROM
products AS p
LEFT JOIN
productlines AS pl ON p.productLine = pl.productLine;

-- ============================================================================
-- Question 3: RIGHT JOIN – Customers and Orders
-- Task: Retrieve orderDate, shippedDate, status, and customerNumber for the
--       first 10 orders by joining customers with orders using customerNumber.
-- ============================================================================

SELECT
o.orderDate,
o.shippedDate,
o.status,
o.customerNumber
FROM
customers AS c
RIGHT JOIN
orders AS o ON c.customerNumber = o.customerNumber
LIMIT 10;
